# Copy this file to .env and fill in real values before running the stack.
# See HuongDanCaiDat.txt for how to generate each of these.

GEMINI_API_KEY=your_google_gemini_api_key_here
DB_PASSWORD=your_database_password_here
JWT_PRIVATE_KEY=your_base64_pkcs8_private_key_here
JWT_PUBLIC_KEY=your_base64_x509_public_key_here
JWT_SIGNING_KID=mhsa-key-1
JWT_ISSUER=mhsa-auth
JWT_AUDIENCE=mhsa-api
JWT_ALLOW_HS256_FALLBACK=false

# AES-256 key used to encrypt AI chat messages at rest. Must be exactly 32 bytes.
# If left unset, ai-service falls back to a well-known default — do not use that in anything
# beyond a local demo.
MHSA_CHAT_AES_KEY=change-this-32-byte-secret-key!!

# Public base URL used to build presigned MinIO media links returned to clients. The default
# below matches the local nginx gateway from docker-compose.yml. Only override this for a real
# deployment (e.g. https://your-domain.example).
S3_PUBLIC_ENDPOINT=http://localhost:8080
